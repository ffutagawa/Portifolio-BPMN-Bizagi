<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_03" targetNamespace="https://example.org/portfolio-bpmn" exporter="Portfolio demonstrativo" exporterVersion="1.0">
  <bpmn:process id="Process_1" name="Análise de problemas recorrentes" isExecutable="false">
    <bpmn:documentation>Estudo demonstrativo TO-BE. Não representa processo implantado. Investigar causas, controlar pendências e verificar redução sustentada da recorrência.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Gestão de problemas">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pendente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>encerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Sustentação / Especialistas">
        <bpmn:flowNodeRef>analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coletar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planejar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrigir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Responsável pelo serviço">
        <bpmn:flowNodeRef>priorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>medir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Recorrência identificada">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="registrar" name="Registrar problema e vincular incidentes">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="analisar" name="Analisar evidências e causa raiz">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Causa confirmada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="coletar" name="Coletar dados e testar hipóteses">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="planejar" name="Documentar causa e propor correção">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="priorizar" name="Avaliar risco e priorizar correção">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Correção autorizada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="pendente" name="Registrar risco e data de reavaliação">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="espera" name="Data de reavaliação">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_reavaliacao">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">dataReavaliacao</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="corrigir" name="Solicitar mudança e acompanhar correção">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="medir" name="Monitorar eficácia da correção">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="Correção eficaz?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="encerrar" name="Atualizar conhecimento e encerrar">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim" name="Problema encerrado">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="registrar" targetRef="analisar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="analisar" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g1" targetRef="coletar" name="Não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="coletar" targetRef="analisar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="g1" targetRef="planejar" name="Sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="planejar" targetRef="priorizar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="priorizar" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="g2" targetRef="pendente" name="Não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="pendente" targetRef="espera" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="espera" targetRef="priorizar" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="g2" targetRef="corrigir" name="Sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="corrigir" targetRef="medir" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="medir" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="g3" targetRef="analisar" name="Não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="g3" targetRef="encerrar" name="Sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="encerrar" targetRef="fim" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="Análise de problemas recorrentes" processRef="Process_1" />
  </bpmn:collaboration>
